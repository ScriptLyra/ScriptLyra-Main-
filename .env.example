# ScriptLyra — Supabase
# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings → API). Only the public anon key belongs here; the
# service_role key must never be committed or shipped to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Site URL ──────────────────────────────────────────────────────────────────
# Used to build absolute redirect URLs for OAuth, magic links, etc.
# Leave unset in local dev (requestOrigin() falls back to request headers).
NEXT_PUBLIC_SITE_URL=

# ── Google Cloud Console — OAuth 2.0 ─────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials.
# GOOGLE_CLIENT_SECRET is SERVER-ONLY — never prefix with NEXT_PUBLIC_.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
